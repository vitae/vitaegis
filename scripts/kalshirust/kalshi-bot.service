# systemd unit for the Rust bot (kalshiRUST). Installed by remote-setup.sh:
#   binary   /opt/kalshirust/target/release/kalshi_btc_bot
#   runtime  /var/lib/kalshirust  (.env, kalshi_private.key, trades.jsonl, settle_calib.jsonl)
[Unit]
Description=KALSHIRUST: Kalshi KXBTC15M bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=kalshi
WorkingDirectory=/var/lib/kalshirust
ExecStart=/opt/kalshirust/target/release/kalshi_btc_bot
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/kalshirust
ReadWritePaths=/var/lib/kalshirust

[Install]
WantedBy=multi-user.target
